<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <title><%= produk.name %> - Toko Sembako Ariesta</title>
</head>
<body class="font-body text-brand-dark min-h-screen flex flex-col">
  <%- include('partials/navbar') %>

  <main class="max-w-2xl mx-auto px-6 py-10 flex-1">
    <article class="glass-card rounded-2xl p-8">
      <h1 class="font-heading text-2xl font-bold text-brand-dark mb-4"><%= produk.name %></h1>
      <p class="text-brand-dark/70 mb-2">Kategori: <%= produk.category %></p>
      <p class="text-brand-gold font-semibold text-xl mb-2">Rp <%= produk.price.toLocaleString('id-ID') %></p>
      <p class="text-brand-dark/70 mb-6">Stok: <%= produk.stock %></p>
      <a href="/produk" class="text-brand hover:text-brand-dark font-medium">&larr; Kembali ke Produk</a>
    </article>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>